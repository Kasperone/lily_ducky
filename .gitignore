# Build artifacts
firmware/.pio/
firmware/.platformio/
firmware/build/

# USB / upload artifacts
*.uf2

# IDE
.vscode/
.idea/

# Agent state (local to each clone — Hermes uses ~/.hermes for shared state).
# Exception: .hermes/plans/ — hardware bring-up dossiers, sanitized and
# tracked deliberately (see docs/knowledge-base/open-questions.md #6) so the
# most detailed hardware evidence this project has travels with the repo
# instead of living only on one machine. Everything else under .hermes/
# (sessions, cache, per-clone scratch) stays untracked.
.hermes/*
!.hermes/plans/
.claude/

# OS
.DS_Store
Thumbs.db

# Payloads on SD (keep sample .dd files, ignore user-created ones)
# payloads/*.dd  — keeping all in repo for now


# Vault-authored Claude-Docs, linked in per-machine by scripts/link-claude-docs.sh.
# Private agent notes live ONLY in the Obsidian vault, never in this public repo.
/Claude-Docs
