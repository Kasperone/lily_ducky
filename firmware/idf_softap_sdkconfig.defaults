# =============================================================================
# sdkconfig defaults for the T-Dongle-C5-idf environment only.
# =============================================================================
# Why this file exists instead of firmware/sdkconfig.defaults:
#
#   * firmware/sdkconfig.defaults is GENERATED by pioarduino for the Arduino
#     environments (it is the Arduino core's whole sdkconfig with our
#     custom_sdkconfig overrides layered on) and is gitignored. It carries
#     CONFIG_SPIRAM=y, which must never reach this build (issue #18).
#   * For framework = espidf PlatformIO ignores `custom_sdkconfig` entirely
#     (espidf.py sets flag_custom_sdkonfig = False when "espidf" is in
#     PIOFRAMEWORK), so the ESP-IDF build has no other way to pin keys.
#
# platformio.ini passes this file to CMake as -DSDKCONFIG_DEFAULTS. NOTE: the
# PlatformIO espidf builder only re-runs CMake when sdkconfig.defaults/project
# files change, so after editing THIS file delete sdkconfig.T-Dongle-C5-idf (or
# run `pio run -e T-Dongle-C5-idf -t clean`) to force a re-configure.
#
# Base: the hardware-proven hybrid tree (/home/op/scratch/c5_hybrid_pcap,
# issue #9). The WiFi/LWIP keys below are the ones that matter for the SoftAP
# downlink path; verified against that tree's sdkconfig.c5min after building.
# =============================================================================

# ── Console: USB Serial/JTAG is the only console the C5 exposes. Without this
# key the boot log (and the C2 auth token) goes to a UART pin nothing is wired
# to, which reads as a dead board.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ── Flash / partitions ──────────────────────────────────────────────────────
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Match the DIO mode the hybrid image was built and flashed with.
# CONFIG_ESPTOOLPY_FLASHMODE_QIO is not set
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="idf_softap_partitions.csv"

# ── PSRAM OFF — hard requirement (issue #18 / open-questions #9). The C5's
# PSRAM path is what made the precompiled Arduino core reboot-loop, and neither
# the hybrid SoftAP image nor any layer built on it ever enabled it.
# CONFIG_SPIRAM is not set

# ── WiFi TX path: the exact shape of the known-good hybrid build. Moving these
# away from these values is what made the Arduino env's SoftAP start Guru-panic
# (see docs/knowledge-base/issue-9-softap-findings.md), so they are pinned
# rather than left to the IDF defaults.
# CONFIG_ESP_WIFI_STATIC_TX_BUFFER is not set
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=1
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y

# The C5 is single-core; the hybrid image was built unicore and its task
# priorities (httpd, tcpip, recon) are tuned for that.
CONFIG_FREERTOS_UNICORE=y

# ── FATFS long file names on the heap: payload names are not 8.3. Storage only,
# never touches the WiFi/lwIP path.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64
