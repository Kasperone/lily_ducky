REM Cross-platform router with OS detection (DuckyScript 3.0)
REM Detects the OS and branches accordingly
REM
REM DETECT_OS runs a cooperative 3s window observing host keyboard-LED
REM traffic and sets $_OS (WINDOWS=1, MACOS=2, LINUX=3, else 0).

VAR $os_detected = 0

DETECT_OS

IF ($_OS == WINDOWS) THEN
    GUI r
    DELAY 500
    STRINGLN cmd
    DELAY 500
    STRINGLN echo LilyDucky detected Windows
    ENTER
ELSE_IF ($_OS == LINUX) THEN
    CTRL ALT t
    DELAY 500
    STRINGLN echo LilyDucky detected Linux
    ENTER
ELSE_IF ($_OS == MACOS) THEN
    GUI SPACE
    DELAY 500
    STRINGLN terminal
    DELAY 1000
    STRINGLN echo LilyDucky detected macOS
    ENTER
END_IF
